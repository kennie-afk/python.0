POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-before-you-run-this
POSTGRES_DB=aegis
# The API runs as the unprivileged role aegis_app, which cannot bypass row-level security. Its password
# is applied after every migration. 16-128 characters, no quotes (hex is safe: openssl rand -hex 16).
AEGIS_APP_PASSWORD=generate-a-random-value-of-at-least-16-characters
POSTGRES_PORT=5432

# Host ports. Change them when another system already holds 3000, 8000 or 5432.
AEGIS_PORT=8000
AEGIS_CONSOLE_PORT=3000

# `make demo` turns this on for one command; leave it false everywhere else.
AEGIS_ALLOW_DEMO_SEED=false
# Only for signing in over plain http from a host other than localhost.
AEGIS_COOKIE_SECURE=true

AEGIS_JWT_SECRET=generate-a-random-value-of-at-least-32-characters
AEGIS_ANONYMISATION_SALT=generate-a-second-random-value-and-never-rotate-it

AEGIS_MODEL_API_KEY=
AEGIS_MODEL_NAME=gpt-4o-mini
AEGIS_MODEL_BASE_URL=https://api.openai.com/v1

AEGIS_SMTP_HOST=
AEGIS_SMTP_PORT=587
AEGIS_SMTP_USERNAME=
AEGIS_SMTP_PASSWORD=

# Keys that live outside the database. AEGIS_ENV=production makes the ledger key mandatory: without it the
# audit trail is tamper-evident only against partial edits. 32+ characters each.
AEGIS_ENV=
AEGIS_LEDGER_SIGNING_KEY=
# Signs trained models. Leave empty to derive one from AEGIS_JWT_SECRET.
AEGIS_MODEL_SIGNING_KEY=
# Failed sign-ins per minute per address before /v1/auth/token answers 429.
AEGIS_TOKEN_FAILURES_PER_MINUTE=10
# Alerts (model blocked or warned, drift, retrain recommended, integrity failures, sentiment warnings).
AEGIS_ALERT_WEBHOOK=
AEGIS_ALERT_WEBHOOK_SECRET=
AEGIS_ALERT_EMAIL_TO=
# How often the `checks` service runs, and when a model counts as old.
AEGIS_CHECK_INTERVAL_SECONDS=900
AEGIS_RETRAIN_MAX_AGE_DAYS=90
