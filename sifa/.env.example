SIFA_API_KEYS=generate-a-random-key-of-at-least-24-characters
SIFA_CORS_ORIGINS=
SIFA_API_PORT=8000
SIFA_CONSOLE_PORT=3200

# Demo only. 0 starts cold (every screen at zero). 2500 serves that many real feeds at start-up, about
# 30 seconds, so the experiment, drift and registry screens have history; release history is tagged
# "(demo warm-up)" in the registry.
SIFA_DEMO_WARMUP=0

# Keys may carry a role: "key:viewer,key:operator,key:admin". A bare key is an admin. List old and
# new keys together to rotate.
# SIFA_API_KEYS=<viewer-key>:viewer,<ops-key>:operator,<admin-key>:admin

# Where durable state lives (sqlite + npz artifacts). Compose mounts a volume here.
# SIFA_STATE_DIR=./state

# "simulated" (default) or "feedback": where experiment and guard outcomes come from.
SIFA_OUTCOME_MODE=simulated

# Optional: alerts (guard rollback, live drift, scheduled retrain) are POSTed here as JSON.
SIFA_ALERT_WEBHOOK=
# Optional: train a new canary every N seconds. 0 = off.
SIFA_RETRAIN_EVERY_SECONDS=0
